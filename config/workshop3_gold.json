{
  "schema_version": "weather-gold-v2-course-eda",
  "input_register": "workshop_3/evidence/silver_review.json",
  "silver_folder": "datalake_silver",
  "text_register": "workshop_3/samples/silver_text/noaa_oklahoma_2021_text.manifest.json",
  "text_folder": "datalake_silver/text",
  "output_folder": "datalake_gold",
  "start": "2021-01-01",
  "end": "2025-12-31",
  "spark_master": "local[2]",
  "driver_memory": "1g",
  "shuffle_partitions": 2,
  "iqr_multiplier": 1.5,
  "zscore_threshold": 3.0,
  "schedule": "0 6 * * 1"
}
