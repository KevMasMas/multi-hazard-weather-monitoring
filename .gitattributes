# Source evidence must preserve the exact bytes used for registered checksums.
workshop_1/samples/**/*.csv -text
workshop_1/samples/**/*.geojson -text
workshop_1/samples/*.csv -text
workshop_1/samples/*.geojson -text

# Project text files use stable line endings across Windows and Unix runtimes.
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.tex text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf

# W2 sample hashes refer to exact native/DAG-produced bytes, not Git-normalized text.
workshop_2/samples/native/*.csv -text
workshop_2/samples/bronze/*.json -text
workshop_2/samples/lineage/*.json -text
workshop_2/samples/silver/*.parquet binary
requirements*.txt text eol=lf
Dockerfile text eol=lf

# Preserve recorded W3 evidence and native Gold manifests across checkouts.
workshop_3/evidence/*.json -text
workshop_3/evidence/*.csv -text
workshop_3/samples/gold/*.json -text
workshop_3/samples/gold/*.parquet binary
workshop_3/samples/gold/*.csv -text
workshop_3/samples/incremental/*.json -text
workshop_3/*.zip binary
workshop_3/*.pdf binary
