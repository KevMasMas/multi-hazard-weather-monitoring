# Add environment variable names only after their use is justified.
# Never place real credentials or personal contact information in this file.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://weather:weather@postgres:5432/weather_monitoring
POSTGRES_PASSWORD=weather
POSTGRES_PORT=55432

# Local classroom Airflow defaults; use untracked .env overrides as needed.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEBSERVER_SECRET_KEY=local-workshop-only

# NWS requests require an identifying User-Agent. Define the real value locally.
NWS_USER_AGENT=
